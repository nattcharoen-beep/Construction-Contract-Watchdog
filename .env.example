# ==============================================================================
# 🔑 Construction Contract Watchdog — Environment Variables Template
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าคอนฟิกจริงสำหรับการใช้งาน Local Dev และ Production

# LINE Messaging API Configuration (จาก LINE Developers Console)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE LIFF ID สำหรับเปิด Web App ในแอปพลิเคชัน LINE (เช่น 2000000000-XXXXXXXX)
LINE_LIFF_ID=your_line_liff_id_here

# Public URL ของระบบ (ใช้สำหรับแนบ Link ให้แตะใน LINE Message)
# Local: http://localhost:8787
# Production: https://construction-contract-watchdog.your-subdomain.workers.dev
APP_URL=https://construction-contract-watchdog.your-subdomain.workers.dev
